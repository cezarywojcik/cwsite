doctype html
html(lang="en")
  head
    include partials/head
    block head
  body
    div.header
      div.title Cezary Wojcik
      div.subtitle Keyboard Wizard 
      ul.navigation
        li
          a(href="/") Home
        li
          a(href="/blog") Blog
        li
          a(href="/about") About
        li
          a(href="/contact") Contact
        li
          a(href="/gallery") Gallery
    div.page
      div.content
        block content
      div.footer
        div.left-footer
          a(href="http://feeds.feedburner.com/CezaryWojciksBlog", title="Subscribe to my blog!", rel="alternate", type="application/rss+xml", target="_blank")
            div.rss.image
          a(href="https://twitter.com/cezary_wojcik", title="Follow me on twitter!", target="_blank")
            div.twitter.image
          a(href="https://github.com/cezarywojcik", title="Check out my GitHub page!", target="_blank")
            div.github.image
          a(href="https://www.linkedin.com/in/cezarywojcik", title="My LinkedIn Profile", target="_blank")
            div.linkedin.image
        div.right-footer
          a(href="/privacy", style="color:#555") Privacy
          |  · &#169; #{new Date().getFullYear()} Cezary Wojcik
        div.clearfix
